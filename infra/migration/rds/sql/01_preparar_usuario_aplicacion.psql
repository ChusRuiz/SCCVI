\set ON_ERROR_STOP on
\pset pager off

-- Ejecutar conectado a la base RDS ya restaurada, como usuario maestro.
-- Ajusta estos valores si cambiaste db_name, db_username o db_app_username en Terraform.
\set app_user sccvi_app
\set db_owner sccvi_master

\echo '=== Creando/verificando el usuario de aplicación SCCVI ==='

SELECT format(
  'CREATE ROLE %I LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT',
  :'app_user'
)
WHERE NOT EXISTS (
  SELECT 1 FROM pg_roles WHERE rolname = :'app_user'
) \gexec

SELECT format('ALTER ROLE %I LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT', :'app_user') \gexec

SELECT format('GRANT CONNECT ON DATABASE %I TO %I', current_database(), :'app_user') \gexec
SELECT format('GRANT USAGE ON SCHEMA public TO %I', :'app_user') \gexec
SELECT format('GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO %I', :'app_user') \gexec
SELECT format('GRANT USAGE, SELECT, UPDATE ON ALL SEQUENCES IN SCHEMA public TO %I', :'app_user') \gexec

-- Los objetos restaurados se crean bajo db_owner (normalmente sccvi_master).
-- Estas reglas aplican a tablas/secuencias nuevas creadas posteriormente por ese propietario.
SELECT format(
  'ALTER DEFAULT PRIVILEGES FOR ROLE %I IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO %I',
  :'db_owner', :'app_user'
) \gexec

SELECT format(
  'ALTER DEFAULT PRIVILEGES FOR ROLE %I IN SCHEMA public GRANT USAGE, SELECT, UPDATE ON SEQUENCES TO %I',
  :'db_owner', :'app_user'
) \gexec

\echo ''
\echo '=== IMPORTANTE ==='
\echo 'Ahora establece la contraseña de forma interactiva, sin escribirla en un archivo:'
\echo '\\password sccvi_app'
\echo 'Ejecuta ese comando en psql. Luego verifica los permisos antes de iniciar ECS.'
