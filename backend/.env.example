# Entorno
NODE_ENV=development
PORT=3000

# PostgreSQL local. En AWS usar endpoint privado de RDS.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sccvi_db
DB_USER=postgres
DB_PASSWORD=CAMBIAR_EN_TU_ENTORNO
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_APPLICATION_NAME=sccvi
# DB_SSL_CA_PATH=./certs/global-bundle.pem

# Seguridad de sesión: genera un secreto aleatorio de al menos 32 caracteres.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
JWT_EXPIRES_IN=8h

# Frontend y CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=TU_CLAVE_DE_APLICACION
SMTP_FROM=SCCVI <tu_correo@gmail.com>

# Telegram
TELEGRAM_BOT_TOKEN=TOKEN_DEL_BOT
TELEGRAM_BOT_USERNAME=SCCVIhBot
